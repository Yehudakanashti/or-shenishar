# העתיקו לקובץ בשם .env (באותה תיקייה) ומלאו את הערכים
# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# אפשר לשנות מודל; ברירת המחדל היא המודל החזק
CLAUDE_MODEL=claude-opus-5

# --- פייסבוק --- (ראו SETUP-FACEBOOK.md)
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_API_VERSION=v25.0
# אופציונלי — מאפשר לבדוק מתי הטוקן פג
FB_APP_ID=
FB_APP_SECRET=

# --- הרצה מקומית ---
BOT_HOST=127.0.0.1
BOT_PORT=5000
